# agy-multi Environment Variables Template
# Variable inventory only: copying this to a repository-root .env does NOT load it.
# The application reads ~/.config/agy-multi/env (fallback: oauth.env), or inherits
# exported process variables. Existing process variables take precedence.
# Have authorized ops configure test credentials; do not source unreviewed files.
# CLI --host/--port have explicit defaults; pass these flags when changing them.
# NEVER commit real secrets or use the placeholder *** as a real credential.

# OAuth client overrides (real login/refresh also requires authorized account/token state)
AGY_OAUTH_CLIENT_ID=***
AGY_OAUTH_CLIENT_SECRET=***

# Usage Dashboard Server Configuration (Optional)
# Server host binding (e.g. 127.0.0.1 for local, 0.0.0.0 for LAN/Tailscale)
AGY_MULTI_SERVER_HOST=127.0.0.1
# Server port (default 8989)
AGY_MULTI_SERVER_PORT=8989
# Server static API Token for authentication on non-loopback bindings
AGY_MULTI_SERVER_TOKEN=***
# Enable no-auth mode for trusted networks / Tailscale CGNAT
AGY_MULTI_SERVER_NO_AUTH=false

# Trusted Domains & Hostnames (Optional)
# Tailscale MagicDNS tailnet suffix (e.g. your-tailnet.ts.net)
AGY_MULTI_TAILNET=
# Comma-separated list of trusted reverse proxy / tunnel domains (e.g. dash.example.com,*.my-domain.com)
AGY_MULTI_TRUSTED_HOSTS=
